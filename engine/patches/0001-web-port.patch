+            ${SCP_WEB_DIR}/web_api.h
+            ${SCP_WEB_DIR}/web_main.cpp
+            ${SCP_WEB_DIR}/web_mixer.h
+            ${SCP_WEB_DIR}/web_mixer.cpp
+            )
+    set(CMAKE_EXECUTABLE_SUFFIX ".mjs")
+endif()
+
