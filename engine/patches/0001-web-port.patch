+if(EMSCRIPTEN)
+    set_target_properties(SpaceCadetPinball PROPERTIES OUTPUT_NAME "pinball")
+    target_include_directories(SpaceCadetPinball PRIVATE ${SCP_WEB_DIR} SpaceCadetPinball)
+    target_compile_definitions(SpaceCadetPinball PRIVATE SCP_WEB)
+    target_compile_options(SpaceCadetPinball PRIVATE -sUSE_SDL=2 -fno-exceptions -flto)
+    target_link_options(SpaceCadetPinball PRIVATE
+            -sUSE_SDL=2
+            -flto
+            --no-entry
+            -sMODULARIZE=1
+            -sEXPORT_ES6=1
+            -sEXPORT_NAME=createPinball
+            -sENVIRONMENT=web
+            -sINVOKE_RUN=0
+            -sEXIT_RUNTIME=0
+            -sALLOW_MEMORY_GROWTH=1
+            -sINITIAL_MEMORY=64MB
+            -sSTACK_SIZE=1MB
+            -sFORCE_FILESYSTEM=1
+            -sTEXTDECODER=2
+            -sINCOMING_MODULE_JS_API=[locateFile,print,printErr,onAbort,scpAudio,onEngineMessage,wasmBinary,instantiateWasm]
+            "-sEXPORTED_FUNCTIONS=[_malloc,_free]"
+            "-sEXPORTED_RUNTIME_METHODS=[FS,HEAPU8,HEAP32,UTF8ToString,stringToUTF8,lengthBytesUTF8]"
+            )
+endif()
+
